impl {{ trait_name }} for {{ struct_name }} {
{%- if owner_columns %}
    async fn update_one_owned(&self, id: EntityId, owner_field: &'static str, owner: i64, data: {{ entity }}) -> Result<Option<{{ entity }}>, {{ error }}> {
        // Ownership check and write in one statement: someone else's row
        // simply matches nothing (`None`), exactly like a missing one.
        let sql: &'static str = match owner_field {
{%- for o in owner_columns %}
            "{{ o }}" => "UPDATE {{ table }} SET {% for f in data_fields %}{{ f.name }} = ${{ loop.index }}{% if not loop.last %}, {% endif %}{% endfor %} WHERE {{ id_field }} = ${{ next }} AND {{ o }} = ${{ next_owner }} RETURNING {{ all_columns | join(sep=", ") }}",
{%- endfor %}
            other => return Err({{ error }}::ConversionError(format!("'{}' is not an owner column of {{ table }}", other))),
        };
        sqlx::query_as::<_, {{ entity }}>(sql)
{%- for f in data_fields %}
            .bind(data.{{ f.name }})
{%- endfor %}
            .bind(id)
            .bind(owner)
            .fetch_optional(self.db.pool())
            .await
            .map_err({{ error }}::from)
    }

    async fn delete_owned(&self, id: EntityId, owner_field: &'static str, owner: i64) -> Result<Option<{{ entity }}>, {{ error }}> {
        let sql: &'static str = match owner_field {
{%- for o in owner_columns %}
            "{{ o }}" => "DELETE FROM {{ table }} WHERE {{ id_field }} = $1 AND {{ o }} = $2 RETURNING {{ all_columns | join(sep=", ") }}",
{%- endfor %}
            other => return Err({{ error }}::ConversionError(format!("'{}' is not an owner column of {{ table }}", other))),
        };
        sqlx::query_as::<_, {{ entity }}>(sql)
            .bind(id)
            .bind(owner)
            .fetch_optional(self.db.pool())
            .await
            .map_err({{ error }}::from)
    }
{%- else %}
    // {{ entity }} has no integer column an `owner:` could name.
    async fn update_one_owned(&self, _id: EntityId, owner_field: &'static str, _owner: i64, _data: {{ entity }}) -> Result<Option<{{ entity }}>, {{ error }}> {
        Err({{ error }}::ConversionError(format!("'{}' is not an owner column of {{ table }}", owner_field)))
    }

    async fn delete_owned(&self, _id: EntityId, owner_field: &'static str, _owner: i64) -> Result<Option<{{ entity }}>, {{ error }}> {
        Err({{ error }}::ConversionError(format!("'{}' is not an owner column of {{ table }}", owner_field)))
    }
{%- endif %}
}
