        if data.is_empty() {
            return Ok(Vec::new());
        }
        // One round-trip (and one implicit transaction) for the whole batch:
        // columns are sent as arrays and zipped back into rows by UNNEST.
{%- for f in data_fields %}
        let mut col_{{ f.name }} = Vec::with_capacity(data.len());
{%- endfor %}
        for item in data {
{%- for f in data_fields %}
            col_{{ f.name }}.push({% if f.json == "plain" %}sqlx::types::Json(item.{{ f.name }}){% elif f.json == "nullable" %}item.{{ f.name }}.map(sqlx::types::Json){% else %}item.{{ f.name }}{% endif %});
{%- endfor %}
        }
        sqlx::query_as::<_, {{ entity }}>(
            "INSERT INTO {{ table }} ({% for f in data_fields %}{{ f.name }}{% if not loop.last %}, {% endif %}{% endfor %}) SELECT * FROM UNNEST({% for f in data_fields %}${{ loop.index }}::{{ f.sql_type }}[]{% if not loop.last %}, {% endif %}{% endfor %}) RETURNING {{ all_columns | join(sep=", ") }}",
        )
{%- for f in data_fields %}
            .bind(col_{{ f.name }})
{%- endfor %}
            .fetch_all(self.db.pool())
            .await
            .map_err({{ error }}::from)
