        sqlx::query_as::<_, {{ entity }}>(
            "INSERT INTO {{ table }} ({{ columns }}) VALUES ({{ placeholders }}) RETURNING {{ all_columns }}",
        ){% for f in data_fields %}
            .bind(data.{{ f.name }}){% endfor %}
            .fetch_one(self.db.pool())
            .await
            .map_err({{ error }}::from)