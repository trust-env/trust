        sqlx::query_as::<_, {{ entity }}>(
            "UPDATE {{ table }} SET {{ set_clause }} WHERE {{ id_field }} = ${{ next }} RETURNING {{ all_columns }}",
        ){% for f in data_fields %}
            .bind(data.{{ f.name }}){% endfor %}
            .bind(id)
            .fetch_one(self.db.pool())
            .await
            .map_err({{ error }}::from)