        use std::fmt::Write as _;

        // Hard ceiling on one page, whatever the caller asks for.
        const MAX_LIST_LIMIT: i64 = 1000;

        let predicate_count = query.predicates.len();
        let mut sql = String::from("SELECT {{ all_columns }} FROM {{ table }}");
        for (i, predicate) in query.predicates.iter().enumerate() {
            // Whitelist: only real columns ever reach the SQL text, and each
            // one knows its Postgres type so the *parameter* is cast — the
            // column stays bare, so its index stays usable.
            let column_type = match predicate.field.as_str() {
{%- for c in columns %}
                "{{ c.name }}" => "{{ c.sql_type }}",
{%- endfor %}
                other => {
                    return Err({{ error }}::ConversionError(format!(
                        "unknown column '{}' for table {{ table }}",
                        other
                    )))
                }
            };
            sql.push_str(if i == 0 { " WHERE " } else { " AND " });
            let n = i + 1;
            let _ = match predicate.operator {
                StoragePredicateOperator::In => write!(
                    sql,
                    "{} = ANY(string_to_array(${}, ',')::{}[])",
                    predicate.field, n, column_type
                ),
                StoragePredicateOperator::NotIn => write!(
                    sql,
                    "{} <> ALL(string_to_array(${}, ',')::{}[])",
                    predicate.field, n, column_type
                ),
                // Pattern matching only makes sense on text.
                StoragePredicateOperator::Like
                | StoragePredicateOperator::ILike
                | StoragePredicateOperator::Contains => write!(
                    sql,
                    "{}::TEXT {} ${}",
                    predicate.field,
                    predicate.operator.to_string(),
                    n
                ),
                _ => write!(
                    sql,
                    "{} {} ${}::{}",
                    predicate.field,
                    predicate.operator.to_string(),
                    n,
                    column_type
                ),
            };
        }
{%- if order_by %}
        sql.push_str(" ORDER BY {{ order_by }}");
{%- endif %}
        let _ = write!(sql, " LIMIT ${} OFFSET ${}", predicate_count + 1, predicate_count + 2);

        let mut q = sqlx::query_as::<_, {{ entity }}>(sqlx::AssertSqlSafe(sql));
        for predicate in query.predicates {
            q = q.bind(predicate.value);
        }
        q.bind(query.limit.clamp(0, MAX_LIST_LIMIT))
            .bind(query.offset.max(0))
            .fetch_all(self.db.pool())
            .await
            .map_err({{ error }}::from)
