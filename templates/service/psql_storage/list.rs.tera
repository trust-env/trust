        let mut sql = "SELECT {{ all_columns }} FROM {{ table }}".to_string();
        if !query.predicates.is_empty() {
            let clauses = query
                .predicates
                .iter()
                .enumerate()
                .map(|(i, p)| format!("{}::text {} ${}", p.field, p.operator.to_string(), i + 1))
                .collect::<Vec<_>>()
                .join(" AND ");
            sql.push_str(" WHERE ");
            sql.push_str(&clauses);
        }
        sql.push_str(&format!(" LIMIT ${} OFFSET ${}", query.predicates.len() + 1, query.predicates.len() + 2));

        let mut q = sqlx::query_as::<_, {{ entity }}>(sqlx::AssertSqlSafe(sql));
        for predicate in &query.predicates {
            q = q.bind(predicate.value.clone());
        }
        q.bind(query.limit)
            .bind(query.offset)
            .fetch_all(self.db.pool())
            .await
            .map_err({{ error }}::from)