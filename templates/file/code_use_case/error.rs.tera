#[derive(Debug)]
pub enum {{ name }} {
    NotFound,
    StorageError(String),
{%- for variant in variants %}
    {{ variant }}(String),
{%- endfor %}
}

{% for storage_error in storage_errors %}impl From<{{ storage_error }}> for {{ name }} {
    fn from(error: {{ storage_error }}) -> Self {
        match error {
            {{ storage_error }}::NotFound => {{ name }}::NotFound,
            other => {{ name }}::StorageError(format!("{:?}", other)),
        }
    }
}

{% endfor %}/// Lets `?` propagate the `String` errors `s3`/`http_client` infras return.
impl From<String> for {{ name }} {
    fn from(error: String) -> Self {
        {{ name }}::StorageError(error)
    }
}

