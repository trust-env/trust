
/// What `logic::execute` reaches through `deps`.
pub trait {{ name }}Deps {
{%- for a in accessors %}
    fn {{ a.field }}(&self) -> {{ a.returns }};
{%- endfor %}
{%- if journal_handle %}
    /// The journal of the current run (`deps.journal().entry("...")`).
    fn journal(&self) -> &TrustJournal;
{%- endif %}
}

impl{{ generics }} {{ name }}Deps for {{ name }}{{ generics }}
{{ where_clause }}{
{%- for a in accessors %}
    fn {{ a.field }}(&self) -> {{ a.returns }} {
        &self.{{ a.field }}
    }
{%- endfor %}
{%- if journal_handle %}
    fn journal(&self) -> &TrustJournal {
        &self.trust_journal
    }
{%- endif %}
}

