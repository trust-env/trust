    let {{ var }} = {{ name }}::new({% for a in params %}{{ a }}.clone(){% if not loop.last %}, {% endif %}{% endfor %});
    let {{ var }}_address: std::net::SocketAddr = ({{ address }}).parse()?;
    let {{ var }}_task = tokio::spawn(async move {
        tonic::transport::Server::builder()
            .add_service({{ name }}Server::new({{ var }}))
            .serve({{ var }}_address)
            .await
    });
