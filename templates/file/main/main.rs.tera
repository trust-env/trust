use common::{HttpPresenter, SQLConnector, start_http_server};
{%- if has_schedules %}
use common::UseCase;
{%- endif %}
{{ lib_use }}
#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    dotenvy::dotenv().ok();
    init_logging();
{%- if token_command %}

    // `<binary> token <user_id> [days]`: prints a JWT for a service (an
    // agent, a script) signed with JWT_SECRET, valid `days` days (365).
    let args: Vec<String> = std::env::args().collect();
    if args.get(1).map(String::as_str) == Some("token") {
        let user_id: i64 = args
            .get(2)
            .and_then(|v| v.parse().ok())
            .ok_or("usage: token <user_id> [days]")?;
        let days: u64 = args.get(3).and_then(|v| v.parse().ok()).unwrap_or(365);
        let secret = std::env::var("JWT_SECRET").map_err(|_| "JWT_SECRET is not set")?;
        let expires = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs() + days * 86_400;
        let claims = serde_json::json!({ "sub": user_id.to_string(), "user_id": user_id, "exp": expires });
        let token = jsonwebtoken::encode(
            &jsonwebtoken::Header::default(),
            &claims,
            &jsonwebtoken::EncodingKey::from_secret(secret.as_bytes()),
        )?;
        println!("{}", token);
        return Ok(());
    }
{%- endif %}

{{ infras }}
{{ use_cases }}
{%- if mcp_stdio %}
    // `<binary> mcp`: serve the MCP tools over stdin/stdout (for clients
    // that start the server themselves) instead of the network servers.
    if std::env::args().nth(1).as_deref() == Some("mcp") {
        let user: i64 = std::env::var("MCP_USER_ID").ok().and_then(|v| v.parse().ok()).unwrap_or({{ mcp_stdio.user }});
        let server = std::sync::Arc::new({{ mcp_stdio.name }}::new({% for p in mcp_stdio.params %}{{ p }}.clone(){% if not loop.last %}, {% endif %}{% endfor %}));
        return server.serve_stdio(user).await.map_err(Into::into);
    }
{% endif %}
{% for block in blocks %}{{ block }}
{% endfor %}{% for var in task_vars %}    {{ var }}.await??;
{% endfor %}
    Ok(())
}

/// `RUST_LOG` selects what is logged (default `info`); `LOG_FORMAT=json`
/// prints one JSON object per line.
fn init_logging() {
    let filter = tracing_subscriber::EnvFilter::try_from_default_env()
        .unwrap_or_else(|_| tracing_subscriber::EnvFilter::new("info"));
    // stderr: stdout is the protocol channel of `<binary> mcp`.
    let builder = tracing_subscriber::fmt().with_env_filter(filter).with_writer(std::io::stderr);
    if std::env::var("LOG_FORMAT").is_ok_and(|format| format == "json") {
        builder.json().init();
    } else {
        builder.init();
    }
}
