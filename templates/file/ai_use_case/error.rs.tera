#[derive(Debug)]
pub enum {{ name }} {
    NotFound,
    StorageError(String),
}

{% if storage_error %}impl From<{{ storage_error }}> for {{ name }} {
    fn from(error: {{ storage_error }}) -> Self {
        match error {
            {{ storage_error }}::NotFound => {{ name }}::NotFound,
            other => {{ name }}::StorageError(format!("{:?}", other)),
        }
    }
}

{% endif -%}
