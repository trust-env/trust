{{ where_clause }}{
    async fn run(&self, {{ user_param }}: i64, input: {{ input }}) -> Result<{{ output }}, {{ error }}> {
{{ body }}
    }
}
{%- elif publish %}
        let result = self.run(user, input).await;
        if result.is_ok() {
            crate::trust_publish("{{ name }}", user);
        }
        result
    }
}

