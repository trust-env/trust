impl{{ generics }} UseCase<{{ input }}, {{ output }}, {{ error }}> for {{ name }}{{ generics }}
{{ where_clause }}{
    async fn execute(&self, {% if publish %}user{% else %}{{ user_param }}{% endif %}: i64, input: {{ input }}) -> Result<{{ output }}, {{ error }}> {
{%- if transaction %}
        // One database transaction for the whole run: committed when it
        // succeeds, rolled back on any error.
        let tx = self.{{ tx_first }}.begin().await.map_err(|e| {{ error }}::StorageError(e.to_string()))?;
        let scoped = Self {
{%- for f in tx_fields %}
            {{ f.field }}: {% if f.storage %}self.{{ f.field }}.in_transaction(&tx){% else %}self.{{ f.field }}.clone(){% endif %},
{%- endfor %}
        };
        match scoped.run({% if publish %}user{% else %}{{ user_param }}{% endif %}, input).await {
            Ok(output) => {
                crate::commit_transaction(&tx)
                    .await
                    .map_err(|e| {{ error }}::StorageError(e.to_string()))?;
{%- if publish %}
                crate::trust_publish("{{ name }}", user);
{%- endif %}
                Ok(output)
            }
            Err(error) => {
                let _ = crate::rollback_transaction(&tx).await;
                Err(error)
            }
        }
    }
}

