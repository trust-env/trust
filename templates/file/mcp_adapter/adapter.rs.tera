//! Model Context Protocol server `{{ name }}`: every tool runs one use case.
//! Transports: Streamable HTTP (`POST /mcp`, JSON responses) and stdio
//! (`<binary> mcp`, one JSON-RPC message per line).

use std::sync::Arc;

use axum::{
    Json, Router,
    extract::State,
    http::{HeaderMap, StatusCode},
    response::{IntoResponse, Response},
    routing::post,
};
use common::HttpPresenter;
use serde_json::{Value, json};
{{ crate_use }}
/// Protocol revisions this server speaks, newest first.
const PROTOCOL_VERSIONS: &[&str] = &["2025-06-18", "2025-03-26", "2024-11-05"];

pub struct {{ name }}<{{ generics }}>
where
{{ where_clause }}{
{%- for t in use_cases %}
    {{ t.field }}: {{ t.type_param }},
{%- endfor %}
}

impl<{{ generics }}> {{ name }}<{{ generics }}>
where
{{ where_clause }}{
    pub fn new({% for t in use_cases %}{{ t.field }}: {{ t.type_param }}{% if not loop.last %}, {% endif %}{% endfor %}) -> Self {
        Self { {% for t in use_cases %}{{ t.field }}{% if not loop.last %}, {% endif %}{% endfor %} }
    }

    fn tools() -> Value {
        json!([
{%- for t in tools %}
            {
                "name": {{ t.name_literal }},
                "description": {{ t.description_literal }},
                "inputSchema": serde_json::from_str::<Value>({{ t.schema_literal }}).expect("schema generated by trust"),
            },
{%- endfor %}
        ])
    }

    async fn call_tool(&self, user: i64, name: &str, arguments: Value) -> Value {
        let arguments = if arguments.is_null() { json!({}) } else { arguments };
        let outcome: Result<Value, String> = match name {
{%- for t in tools %}
            {{ t.name_literal }} => match serde_json::from_value::<{{ t.input }}>(arguments) {
                Ok(input) => match self.{{ t.field }}.execute(user, input).await {
                    Ok(output) => serde_json::to_value(&output).map_err(|e| e.to_string()),
                    Err(error) => Err(format!("{:?}", error)),
                },
                Err(error) => Err(format!("invalid arguments: {}", error)),
            },
{%- endfor %}
            other => Err(format!("unknown tool '{}'", other)),
        };
        match outcome {
            Ok(value) => {
                let text = serde_json::to_string_pretty(&value).unwrap_or_default();
                let mut result = json!({ "content": [{ "type": "text", "text": text }], "isError": false });
                if value.is_object() {
                    result["structuredContent"] = value;
                }
                result
            }
            Err(message) => json!({ "content": [{ "type": "text", "text": message }], "isError": true }),
        }
    }

    /// Handles one JSON-RPC message; `None` for notifications.
    pub async fn handle(&self, user: i64, message: Value) -> Option<Value> {
        let id = message.get("id").cloned()?;
        let method = message.get("method").and_then(Value::as_str).unwrap_or_default();
        let params = message.get("params").cloned().unwrap_or(Value::Null);
        let result = match method {
            "initialize" => {
                let requested = params.get("protocolVersion").and_then(Value::as_str).unwrap_or_default();
                let version = PROTOCOL_VERSIONS
                    .iter()
                    .find(|v| **v == requested)
                    .copied()
                    .unwrap_or(PROTOCOL_VERSIONS[0]);
                let mut result = json!({
                    "protocolVersion": version,
                    "capabilities": { "tools": { "listChanged": false } },
                    "serverInfo": { "name": {{ server_name_literal }}, "version": env!("CARGO_PKG_VERSION") },
                });
{%- if instructions_literal %}
                result["instructions"] = json!({{ instructions_literal }});
{%- endif %}
                Ok(result)
            }
            "ping" => Ok(json!({})),
            "tools/list" => Ok(json!({ "tools": Self::tools() })),
            "tools/call" => {
                let name = params.get("name").and_then(Value::as_str).unwrap_or_default().to_string();
                let arguments = params.get("arguments").cloned().unwrap_or(Value::Null);
                tracing::info!(tool = %name, user, "mcp tool call");
                Ok(self.call_tool(user, &name, arguments).await)
            }
            other => Err(json!({ "code": -32601, "message": format!("method not found: {}", other) })),
        };
        Some(match result {
            Ok(result) => json!({ "jsonrpc": "2.0", "id": id, "result": result }),
            Err(error) => json!({ "jsonrpc": "2.0", "id": id, "error": error }),
        })
    }

    /// Serves MCP over stdin/stdout (logs go to stderr), acting as `user`.
    pub async fn serve_stdio(self: Arc<Self>, user: i64) -> Result<(), String> {
        use tokio::io::{AsyncBufReadExt, AsyncWriteExt};

        let mut lines = tokio::io::BufReader::new(tokio::io::stdin()).lines();
        let mut stdout = tokio::io::stdout();
        while let Some(line) = lines.next_line().await.map_err(|e| e.to_string())? {
            if line.trim().is_empty() {
                continue;
            }
            let reply = match serde_json::from_str::<Value>(&line) {
                Ok(message) => self.handle(user, message).await,
                Err(error) => Some(json!({
                    "jsonrpc": "2.0",
                    "id": null,
                    "error": { "code": -32700, "message": format!("parse error: {}", error) },
                })),
            };
            if let Some(reply) = reply {
                let mut out = reply.to_string();
                out.push('\n');
                stdout.write_all(out.as_bytes()).await.map_err(|e| e.to_string())?;
                stdout.flush().await.map_err(|e| e.to_string())?;
            }
        }
        Ok(())
    }

    /// The user a request acts as, from its credentials.
    fn authenticate(headers: &HeaderMap) -> Result<i64, (StatusCode, &'static str)> {
{%- if auth == "jwt" %}
        #[derive(serde::Deserialize)]
        struct Claims {
            user_id: i64,
        }
        let token = headers
            .get("authorization")
            .and_then(|value| value.to_str().ok())
            .and_then(|value| value.strip_prefix("Bearer "))
            .ok_or((StatusCode::UNAUTHORIZED, "Missing token"))?;
        let secret = std::env::var("JWT_SECRET")
            .map_err(|_| (StatusCode::INTERNAL_SERVER_ERROR, "JWT_SECRET not configured"))?;
        jsonwebtoken::decode::<Claims>(
            token,
            &jsonwebtoken::DecodingKey::from_secret(secret.as_bytes()),
            &jsonwebtoken::Validation::new(jsonwebtoken::Algorithm::HS256),
        )
        .map(|data| data.claims.user_id)
        .map_err(|_| (StatusCode::UNAUTHORIZED, "Invalid token"))
{%- elif auth == "secret" %}
        let expected: String = {{ secret_expr }};
        let provided = headers
            .get({{ secret_header_literal }})
            .and_then(|value| value.to_str().ok()){% if secret_bearer %}
            .and_then(|value| value.strip_prefix("Bearer ")){% endif %}
            .unwrap_or("");
        let matches = !expected.is_empty()
            && provided.len() == expected.len()
            && provided.bytes().zip(expected.bytes()).fold(0u8, |acc, (a, b)| acc | (a ^ b)) == 0;
        if matches {
            Ok({{ secret_user }})
        } else {
            Err((StatusCode::UNAUTHORIZED, "Invalid or missing secret"))
        }
{%- else %}
        let _ = headers;
        Ok(0)
{%- endif %}
    }
}

async fn mcp_post<{{ generics }}>(
    State(server): State<Arc<{{ name }}<{{ generics }}>>>,
    headers: HeaderMap,
    Json(body): Json<Value>,
) -> Response
where
{{ where_clause }}{
    let user = match {{ name }}::<{{ generics }}>::authenticate(&headers) {
        Ok(user) => user,
        Err(rejection) => return rejection.into_response(),
    };
    let replies: Vec<Value> = match body {
        Value::Array(messages) => {
            let mut replies = Vec::new();
            for message in messages {
                replies.extend(server.handle(user, message).await);
            }
            replies
        }
        message => server.handle(user, message).await.into_iter().collect(),
    };
    match replies.len() {
        // Only notifications / responses: nothing to answer.
        0 => StatusCode::ACCEPTED.into_response(),
        1 => Json(replies.into_iter().next().unwrap_or_default()).into_response(),
        _ => Json(Value::Array(replies)).into_response(),
    }
}

impl<{{ generics }}> HttpPresenter for {{ name }}<{{ generics }}>
where
{{ where_clause }}{
    fn router(self: Arc<Self>) -> Router {
        Router::new()
            // No server-initiated stream: GET is not offered (405).
            .route("/mcp", post(mcp_post::<{{ generics }}>))
            .with_state(self)
            .layer(tower_http::trace::TraceLayer::new_for_http())
    }
}
