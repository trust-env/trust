impl {{ struct_name }} {
    // Kept as `tonic::transport::Error` (rather than wrapped in
    // `{{ error_name }}`) so `main()`'s `?` — which needs `Box<dyn
    // std::error::Error>` — works without `{{ error_name }}` itself having
    // to implement `std::error::Error`; that type only needs to round-trip
    // through use_case `errors {}` mappings, never through `main`.
    pub async fn connect(addr: &str) -> Result<Self, tonic::transport::Error> {
        let client = proto::{{ client_module }}::{{ service_name }}Client::connect(format!("http://{}", addr)).await?;
        Ok(Self { client })
    }
}

