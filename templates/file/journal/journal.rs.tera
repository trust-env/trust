{% if f.json == "plain" %}sqlx::types::Json({{ var }}.{{ f.name }}){% elif f.json == "nullable" %}{{ var }}.{{ f.name }}.map(sqlx::types::Json){% else %}{{ var }}.{{ f.name }}{% endif %}
