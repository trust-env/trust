#[derive(Debug, Clone, Default, serde::Deserialize)]{% if camel %}
#[serde(rename_all = "camelCase")]{% endif %}
pub struct {{ name }} {
{% for field in fields %}{% if field.double_option %}    #[serde(default, deserialize_with = "crate::trust_double_option")]
{% elif field.regex_fn %}{% if field.regex_optional %}    #[serde(default, deserialize_with = "crate::{{ field.regex_fn }}_opt")]
{% else %}    #[serde(deserialize_with = "crate::{{ field.regex_fn }}")]
{% endif %}{% endif %}    pub {{ field.name }}: {{ field.field_type }},
{% endfor -%}
}
