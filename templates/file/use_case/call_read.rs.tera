        self.{{ field }}
            .{{ method }}({{ args }})
            .await
            .map_err({{ error }}::from)?
{% if owner %}            .filter(|entity| entity.{{ owner }} == user)
{% endif %}            .ok_or({{ error }}::NotFound){% if is_tail %}
            .map({{ output }}::from){% else %}?;
{% endif -%}