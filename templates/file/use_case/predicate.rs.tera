StoragePredicate { field: {{ p.field_literal }}.to_string(), operator: StoragePredicateOperator::{{ p.operator }}, value: {% if p.source == "input" %}{% set v = "input." ~ p.value %}{% if p.optional %}{% set v = "value" %}{% endif %}{% if p.conversion == "join" %}{{ v }}.iter().map(|v| v.to_string()).collect::<Vec<_>>().join(","){% elif p.contains %}format!("%{}%", {{ v }}){% else %}{{ v }}.to_string(){% endif %}{% elif p.source == "literal" %}{{ p.value }}.to_string(){% elif p.source == "now" %}chrono::Utc::now().to_rfc3339(){% elif p.source == "today" %}chrono::Utc::now().date_naive().to_string(){% else %}user.to_string(){% endif %} }