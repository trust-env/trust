        // Shared-secret auth: compared in constant time.
        let expected: String = {{ value_expr }};
        let provided = auth_headers
            .get({{ header_literal }})
            .and_then(|value| value.to_str().ok()){% if bearer %}
            .and_then(|value| value.strip_prefix("Bearer ")){% endif %}
            .unwrap_or("");
        let matches = !expected.is_empty()
            && provided.len() == expected.len()
            && provided.bytes().zip(expected.bytes()).fold(0u8, |acc, (a, b)| acc | (a ^ b)) == 0;
        if !matches {
            return Err(HttpError::new(StatusCode::UNAUTHORIZED, "Invalid or missing secret".to_string()));
        }
