
/// Server-Sent Events: one `change` event per successful write (use cases
/// with `notify`), as JSON `{ "use_case", "user", "at" }`.
{%- if requires_user %} Only the caller's own events are sent; the JWT
/// comes from the `Authorization` header or an `access_token` query
/// parameter (a browser `EventSource` can't set headers).{% endif %}
async fn events_stream(
{%- if requires_user %}
    headers: axum::http::HeaderMap,
    axum::extract::Query(query): axum::extract::Query<std::collections::HashMap<String, String>>,
{%- endif %}
) -> Result<
    axum::response::sse::Sse<impl tokio_stream::Stream<Item = Result<axum::response::sse::Event, std::convert::Infallible>>>,
    (axum::http::StatusCode, &'static str),
> {
    use tokio_stream::StreamExt as _;
{%- if requires_user %}
    #[derive(serde::Deserialize)]
    struct Claims {
        user_id: i64,
    }
    let token = headers
        .get("authorization")
        .and_then(|value| value.to_str().ok())
        .and_then(|value| value.strip_prefix("Bearer "))
        .map(str::to_string)
        .or_else(|| query.get("access_token").cloned())
        .ok_or((axum::http::StatusCode::UNAUTHORIZED, "Missing token"))?;
    let secret = std::env::var("JWT_SECRET")
        .map_err(|_| (axum::http::StatusCode::INTERNAL_SERVER_ERROR, "JWT_SECRET not configured"))?;
    let claims = jsonwebtoken::decode::<Claims>(
        &token,
        &jsonwebtoken::DecodingKey::from_secret(secret.as_bytes()),
        &jsonwebtoken::Validation::new(jsonwebtoken::Algorithm::HS256),
    )
    .map_err(|_| (axum::http::StatusCode::UNAUTHORIZED, "Invalid token"))?
    .claims;
    let only_user = Some(claims.user_id);
{%- else %}
    let only_user: Option<i64> = None;
{%- endif %}
    let stream = tokio_stream::wrappers::BroadcastStream::new(crate::trust_subscribe()).filter_map(move |event| {
        let event = event.ok()?;
        if only_user.is_some_and(|user| user != event.user) {
            return None;
        }
        axum::response::sse::Event::default().event("change").json_data(&event).ok().map(Ok)
    });
    Ok(axum::response::sse::Sse::new(stream).keep_alive(axum::response::sse::KeepAlive::default()))
}
