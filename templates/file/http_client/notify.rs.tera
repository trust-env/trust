//! Notification channels (`channel {}`, `notifications {}`, `bot {}`).

/// What happened to one notification.
#[derive(Debug, Clone, serde::Serialize)]
pub struct TrustDelivery {
    /// The channel that took it (`telegram`, `log`, ...), or the last tried.
    pub channel: String,
    /// `sent`, `logged` or `failed`.
    pub status: String,
    /// Why the channels before it (or every channel) failed.
    pub error: Option<String>,
    /// The message id at the channel (Telegram: `message_id`).
    pub external_id: Option<String>,
}

/// Sends `text` on Telegram; returns the `message_id`. The bot token never
/// appears in an error.
pub async fn trust_send_telegram(
    client: &reqwest::Client,
    api_url: &str,
    token: &str,
    chat: &str,
    text: &str,
    reply_to: Option<&str>,
) -> Result<String, String> {
    if token.trim().is_empty() || chat.trim().is_empty() {
        return Err("not configured (token or chat empty)".to_string());
    }
    // Telegram refuses messages over 4096 characters.
    let text: String = text.chars().take(4000).collect();
    let mut body = serde_json::json!({ "chat_id": chat.trim(), "text": text, "disable_web_page_preview": true });
    if let Some(id) = reply_to.and_then(|id| id.parse::<i64>().ok()) {
        body["reply_parameters"] = serde_json::json!({ "message_id": id });
    }
    let url = format!("{}/bot{}/sendMessage", api_url.trim_end_matches('/'), token.trim());
    let hide = |text: String| text.replace(token.trim(), "<token>");
    let response = client.post(&url).json(&body).send().await.map_err(|e| hide(e.to_string()))?;
    let status = response.status();
    let reply: serde_json::Value = response.json().await.unwrap_or_default();
    if !status.is_success() {
        return Err(hide(format!("Telegram responded {}: {}", status, reply)));
    }
    reply["result"]["message_id"]
        .as_i64()
        .map(|id| id.to_string())
        .ok_or_else(|| hide(format!("unexpected Telegram response: {}", reply)))
}

/// POSTs `text` to a webhook: `{ "content" }` (discord), `{ "text" }`
/// (slack) or `{ "kind", "text" }` (json).
pub async fn trust_send_webhook(client: &reqwest::Client, url: &str, format: &str, kind: &str, text: &str) -> Result<(), String> {
    if url.trim().is_empty() {
        return Err("not configured (url empty)".to_string());
    }
    let body = match format {
        "discord" => serde_json::json!({ "content": text.chars().take(2000).collect::<String>() }),
        "slack" => serde_json::json!({ "text": text }),
        _ => serde_json::json!({ "kind": kind, "text": text }),
    };
    let response = client.post(url.trim()).json(&body).send().await.map_err(|e| e.to_string())?;
    if !response.status().is_success() {
        let status = response.status();
        return Err(format!("webhook responded {}: {}", status, response.text().await.unwrap_or_default()));
    }
    Ok(())
}
