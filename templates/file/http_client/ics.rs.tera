//! iCalendar feeds (`ics_feed {}` infras): occurrences of a published
//! calendar over a window.

use chrono::{DateTime, Duration, NaiveDate, NaiveDateTime, Offset, TimeZone, Utc};

/// One occurrence of a calendar event.
#[derive(Debug, Clone, PartialEq, serde::Serialize)]
pub struct IcsOccurrence {
    /// The event's UID.
    pub uid: String,
    /// The UID, plus `#<start of the occurrence in UTC>` for an occurrence
    /// of a recurring event: stable across reads, unique per occurrence.
    pub instance_id: String,
    pub title: String,
    pub start: DateTime<Utc>,
    pub end: DateTime<Utc>,
    pub location: Option<String>,
    pub description: Option<String>,
    pub all_day: bool,
}

struct Prop {
    name: String,
    params: Vec<(String, String)>,
    value: String,
}

impl Prop {
    fn param(&self, key: &str) -> Option<&str> {
        self.params.iter().find(|(k, _)| k.eq_ignore_ascii_case(key)).map(|(_, v)| v.as_str())
    }
}

#[derive(Debug, Clone, Copy)]
enum IcsTime {
    Utc(DateTime<Utc>),
    /// A wall-clock time in a zone.
    Local(NaiveDateTime, chrono_tz::Tz),
    Date(NaiveDate),
}

/// Windows zone names (Outlook writes the organizer's) → IANA: CLDR
