use serde::{Serialize, de::DeserializeOwned};

/// Outbound HTTP client for the `{{ infra }}` infra: every request goes to
/// `base_url` + the given path, with the infra's configured headers.
/// Failures (network errors, non-2xx statuses, undecodable bodies) are
/// returned as a readable `String`. Requests time out after {{ timeout_secs }} s
{%- if retry %} and are retried up to {{ retry }} time(s) after a network error, a 429
/// or a 5xx (backoff 200 ms, 400 ms, ...){% endif %}.
#[derive(Clone)]
pub struct {{ name }} {
    client: reqwest::Client,
    base_url: String,
    headers: reqwest::header::HeaderMap,
    /// `oauth2 {}`: (token_url, client_id, client_secret, refresh_token).
    oauth2: Option<std::sync::Arc<(String, String, String, String)>>,
    /// The current access token and when it expires.
    token: std::sync::Arc<tokio::sync::Mutex<Option<(String, std::time::Instant)>>>,
}

/// Extra attempts after a transient failure.
const RETRIES: u32 = {{ retry }};

impl {{ name }} {
    pub fn new(base_url: String, headers: Vec<(String, String)>) -> Result<Self, String> {
        let mut header_map = reqwest::header::HeaderMap::new();
        for (name, value) in headers {
            let header_name = reqwest::header::HeaderName::from_bytes(name.as_bytes())
                .map_err(|e| format!("invalid header name '{}': {}", name, e))?;
            let header_value = reqwest::header::HeaderValue::from_str(&value)
                .map_err(|e| format!("invalid value for header '{}': {}", name, e))?;
            header_map.insert(header_name, header_value);
        }
        let client = reqwest::Client::builder()
            .timeout(std::time::Duration::from_secs({{ timeout_secs }}))
            .build()
            .map_err(|e| format!("{} client: {}", "{{ infra }}", e))?;
        Ok(Self {
            client,
            base_url: base_url.trim_end_matches('/').to_string(),
            headers: header_map,
            oauth2: None,
            token: Default::default(),
        })
    }

    /// Every request carries a bearer token obtained from `refresh_token`
    /// at `token_url` (renewed a minute before it expires, or after a 401).
    pub fn with_oauth2(mut self, token_url: String, client_id: String, client_secret: String, refresh_token: String) -> Self {
        self.oauth2 = Some(std::sync::Arc::new((token_url, client_id, client_secret, refresh_token)));
        self
    }

    /// The base URL (and the `oauth2 {}` values) are set: a source left
    /// unconfigured (an empty `${VAR}`) can be skipped.
    pub fn is_configured(&self) -> bool {
        !self.base_url.trim().is_empty()
            && self.oauth2.as_ref().is_none_or(|o| [&o.0, &o.1, &o.2, &o.3].iter().all(|v| !v.trim().is_empty()))
    }

    /// The current access token, refreshed when missing or about to expire.
    pub async fn access_token(&self) -> Result<Option<String>, String> {
        let Some(oauth2) = &self.oauth2 else { return Ok(None) };
        let mut token = self.token.lock().await;
        if let Some((value, expires)) = token.as_ref() {
            if *expires > std::time::Instant::now() {
                return Ok(Some(value.clone()));
            }
        }
        let (token_url, client_id, client_secret, refresh_token) = oauth2.as_ref();
        if [token_url, client_id, client_secret, refresh_token].iter().any(|v| v.trim().is_empty()) {
            return Err(format!("{} is not configured (oauth2)", "{{ infra }}"));
        }
        let form = [
            ("grant_type", "refresh_token"),
            ("client_id", client_id.as_str()),
            ("client_secret", client_secret.as_str()),
            ("refresh_token", refresh_token.as_str()),
        ];
        let response = self
            .client
            .post(token_url)
            .form(&form)
            .send()
            .await
            .map_err(|e| format!("{} token request failed: {}", "{{ infra }}", e))?;
        let status = response.status();
        let body = response.text().await.unwrap_or_default();
        if !status.is_success() {
            return Err(format!("{} token endpoint responded {}: {}", "{{ infra }}", status, body));
        }
        let json: serde_json::Value =
            serde_json::from_str(&body).map_err(|e| format!("{} token response is not JSON: {}", "{{ infra }}", e))?;
        let value = json["access_token"]
            .as_str()
            .ok_or_else(|| format!("{} token response has no access_token: {}", "{{ infra }}", body))?
            .to_string();
        let lifetime = json["expires_in"].as_u64().unwrap_or(3600).saturating_sub(60).max(30);
        *token = Some((value.clone(), std::time::Instant::now() + std::time::Duration::from_secs(lifetime)));
        Ok(Some(value))
    }

    /// `base_url` + `path`; an empty path is `base_url` itself, and a full
    /// `http(s)://` URL is used as is (a published calendar link, say).
    fn url(&self, path: &str) -> String {
        if path.starts_with("http://") || path.starts_with("https://") {
            path.to_string()
        } else if path.is_empty() {
            self.base_url.clone()
        } else {
            format!("{}/{}", self.base_url, path.trim_start_matches('/'))
        }
    }

    /// A request to `base_url` + `path` with the configured headers, for
    /// anything the helpers below don't cover (per-request headers, bearer
    /// tokens, multipart, ...). Send it with `send_raw` to keep the
    /// retries.
    pub fn request(&self, method: reqwest::Method, path: &str) -> reqwest::RequestBuilder {
        self.client.request(method, self.url(path)).headers(self.headers.clone())
    }

    /// Sends `request`, retrying transient failures, and returns the
    /// response status and body text. Non-2xx statuses are errors.
    pub async fn send_raw(&self, request: reqwest::RequestBuilder) -> Result<(reqwest::StatusCode, String), String> {
        let mut attempt = 0;
        let mut renewed = false;
        loop {
            let mut this_try = request
                .try_clone()
                .ok_or_else(|| format!("{} request body can't be retried", "{{ infra }}"))?;
            if let Some(token) = self.access_token().await? {
                this_try = this_try.bearer_auth(token);
            }
            let outcome = this_try.send().await;
            let transient = match &outcome {
                Err(error) => error.is_connect() || error.is_timeout() || error.is_request(),
                Ok(response) => {
                    response.status() == reqwest::StatusCode::TOO_MANY_REQUESTS || response.status().is_server_error()
                }
            };
            if transient && attempt < RETRIES {
                tokio::time::sleep(std::time::Duration::from_millis(200 << attempt)).await;
                attempt += 1;
                continue;
            }
            let response = outcome.map_err(|e| format!("{} request failed: {}", "{{ infra }}", e))?;
            let status = response.status();
            if status == reqwest::StatusCode::UNAUTHORIZED && self.oauth2.is_some() && !renewed {
                // The token was revoked or expired early: renew it once.
                *self.token.lock().await = None;
                renewed = true;
                continue;
            }
            let body = response
                .text()
                .await
                .map_err(|e| format!("{} response unreadable: {}", "{{ infra }}", e))?;
            if !status.is_success() {
                return Err(format!("{} responded {}: {}", "{{ infra }}", status, body));
            }
            return Ok((status, body));
        }
    }

    async fn send_json<T: DeserializeOwned>(&self, request: reqwest::RequestBuilder) -> Result<T, String> {
        let (_, body) = self.send_raw(request.headers(self.headers.clone())).await?;
        serde_json::from_str(if body.is_empty() { "null" } else { &body })
            .map_err(|e| format!("{} response is not the expected JSON: {} (body: {})", "{{ infra }}", e, body))
    }

    pub async fn get_json<T: DeserializeOwned>(&self, path: &str) -> Result<T, String> {
        self.send_json(self.client.get(self.url(path))).await
    }

    pub async fn post_json<B: Serialize + ?Sized, T: DeserializeOwned>(&self, path: &str, body: &B) -> Result<T, String> {
        self.send_json(self.client.post(self.url(path)).json(body)).await
    }

    pub async fn put_json<B: Serialize + ?Sized, T: DeserializeOwned>(&self, path: &str, body: &B) -> Result<T, String> {
        self.send_json(self.client.put(self.url(path)).json(body)).await
    }

    pub async fn patch_json<B: Serialize + ?Sized, T: DeserializeOwned>(&self, path: &str, body: &B) -> Result<T, String> {
        self.send_json(self.client.patch(self.url(path)).json(body)).await
    }

    pub async fn delete_json<T: DeserializeOwned>(&self, path: &str) -> Result<T, String> {
        self.send_json(self.client.delete(self.url(path))).await
    }

    /// Every item of a paginated JSON list: GETs `path`, reads the array at
    /// `items_key`, and follows the token at `next_key` (sent back as the
    /// query parameter `next_key` without its `next` prefix:
    /// `nextPageToken` → `pageToken`) until there is none.
    pub async fn get_json_paged<T: DeserializeOwned>(&self, path: &str, items_key: &str, next_key: &str) -> Result<Vec<T>, String> {
        let param = match next_key.strip_prefix("next") {
            Some(rest) if !rest.is_empty() => {
                let mut chars = rest.chars();
                chars.next().map(|c| c.to_ascii_lowercase().to_string() + chars.as_str()).unwrap_or_default()
            }
            _ => next_key.to_string(),
        };
        self.get_json_paged_with(path, items_key, next_key, &param).await
    }

    /// `get_json_paged` with an explicit query parameter for the token.
    pub async fn get_json_paged_with<T: DeserializeOwned>(
        &self,
        path: &str,
        items_key: &str,
        next_key: &str,
        param: &str,
    ) -> Result<Vec<T>, String> {
        let mut items = Vec::new();
        let mut next: Option<String> = None;
        for _ in 0..1000 {
            let url = match &next {
                None => path.to_string(),
                Some(token) => {
                    let separator = if path.contains('?') { '&' } else { '?' };
                    let encoded: String = token
                        .bytes()
                        .map(|b| match b {
                            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'_' | b'.' | b'~' => (b as char).to_string(),
                            other => format!("%{:02X}", other),
                        })
                        .collect();
                    format!("{}{}{}={}", path, separator, param, encoded)
                }
            };
            let mut page: serde_json::Value = self.get_json(&url).await?;
            if let Some(array) = page.get_mut(items_key).map(serde_json::Value::take) {
                let page_items: Vec<T> = serde_json::from_value(if array.is_null() { serde_json::json!([]) } else { array })
                    .map_err(|e| format!("{} '{}' items are not the expected JSON: {}", "{{ infra }}", items_key, e))?;
                items.extend(page_items);
            }
            match page.get(next_key).and_then(|v| v.as_str()).filter(|t| !t.is_empty()) {
                Some(token) => next = Some(token.to_string()),
                None => return Ok(items),
            }
        }
        Err(format!("{} returned more than 1000 pages", "{{ infra }}"))
    }

    /// The response body as text (an ICS feed, HTML, CSV, ...).
    pub async fn get_text(&self, path: &str) -> Result<String, String> {
        self.send_raw(self.request(reqwest::Method::GET, path)).await.map(|(_, body)| body)
    }

    /// `application/x-www-form-urlencoded` POST (e.g. OAuth token
    /// refresh), JSON response.
    pub async fn post_form<B: Serialize + ?Sized, T: DeserializeOwned>(&self, path: &str, form: &B) -> Result<T, String> {
        self.send_json(self.client.post(self.url(path)).form(form)).await
    }
}
{% if ics %}
impl {{ name }} {
    /// The feed's occurrences overlapping `[from, to)`: recurring events
    /// expanded (RRULE, EXDATE, moved occurrences), cancelled ones dropped,
    /// all-day events {% if ics_all_day %}spanning local midnights{% else %}skipped{% endif %}. Times without an IANA
    /// TZID read as {{ ics_fallback }}.
    pub async fn occurrences(
        &self,
        from: chrono::DateTime<chrono::Utc>,
        to: chrono::DateTime<chrono::Utc>,
    ) -> Result<Vec<crate::IcsOccurrence>, String> {
        let (occurrences, warnings) = self.occurrences_with_warnings(from, to).await?;
        for warning in warnings {
            tracing::warn!(feed = "{{ infra }}", %warning, "ics feed");
        }
        Ok(occurrences)
    }

    /// `occurrences`, and what couldn't be read (an unreadable RRULE keeps
    /// its first occurrence only).
    pub async fn occurrences_with_warnings(
        &self,
        from: chrono::DateTime<chrono::Utc>,
        to: chrono::DateTime<chrono::Utc>,
    ) -> Result<(Vec<crate::IcsOccurrence>, Vec<String>), String> {
        let text = self.get_text("").await?;
        if !text.contains("BEGIN:VCALENDAR") {
            return Err(format!("{} does not serve an iCalendar feed", "{{ infra }}"));
        }
        Ok(crate::trust_ics_occurrences(&text, from, to, "{{ ics_fallback }}", {{ ics_all_day }}))
    }
}
{% endif %}
{% if notify %}
impl {{ name }} {
    /// The channels a notification of `kind` goes to, tried in order.
    pub fn channels_for(kind: &str) -> &'static [&'static str] {
        match kind {
{%- for r in routing %}
            {{ r.0 }} => &[{{ r.1 }}],
{%- endfor %}
            _ => &[{{ default_channels }}],
        }
    }

    /// The chat a channel posts to (a bot checks incoming messages against it).
    pub fn chat_of(&self, channel: &str) -> Option<String> {
        match channel {
{%- for c in channels %}{% if c.kind == "telegram" %}
            {{ c.name | json_encode() }} => Some({{ c.chat }}).map(|chat: String| chat.trim().to_string()).filter(|chat| !chat.is_empty()),
{%- endif %}{% endfor %}
            _ => None,
        }
    }

    /// Sends on one channel; returns the channel's message id.
    pub async fn send_to(&self, channel: &str, kind: &str, text: &str, reply_to: Option<&str>) -> Result<Option<String>, String> {
        let _ = (kind, reply_to);
        match channel {
{%- for c in channels %}
{%- if c.kind == "telegram" %}
            {{ c.name | json_encode() }} => crate::trust_send_telegram(&self.client, &{{ c.api_url }}, &{{ c.token }}, &{{ c.chat }}, text, reply_to).await.map(Some),
{%- else %}
            {{ c.name | json_encode() }} => crate::trust_send_webhook(&self.client, &{{ c.url }}, {{ c.format | json_encode() }}, kind, text).await.map(|_| None),
{%- endif %}
{%- endfor %}
            "log" => {
                tracing::info!(kind, "notification (log channel):\n{}", text);
                Ok(None)
            }
            other => Err(format!("unknown channel '{}'", other)),
        }
    }

    /// Sends a notification of `kind` on its channels (the first that
    /// works){% if fallback %}, else on {{ fallback }}{% endif %}.
    pub async fn send(&self, kind: &str, text: &str) -> crate::TrustDelivery {
        let mut errors: Vec<String> = Vec::new();
        #[allow(unused_mut)]
        let mut tried: Vec<&str> = Self::channels_for(kind).to_vec();
{%- if fallback %}
        if !tried.contains(&{{ fallback | json_encode() }}) {
            tried.push({{ fallback | json_encode() }});
        }
{%- endif %}
        let mut last = "log";
        for channel in tried {
            last = channel;
            match self.send_to(channel, kind, text, None).await {
                Ok(external_id) => {
                    return crate::TrustDelivery {
                        channel: channel.to_lowercase(),
                        status: if channel == "log" { "logged" } else { "sent" }.to_string(),
                        error: (!errors.is_empty()).then(|| errors.join("; ")),
                        external_id,
                    };
                }
                Err(error) => {
                    tracing::warn!(kind, channel, %error, "notification not sent");
                    errors.push(format!("{}: {}", channel, error));
                }
            }
        }
        crate::TrustDelivery { channel: last.to_lowercase(), status: "failed".to_string(), error: Some(errors.join("; ")), external_id: None }
    }
{%- if record %}

    /// `send`, then records the notification (its channel, status, error
    /// and message id) with `storage`; returns the recorded row.
    pub async fn send_recorded(
        &self,
        storage: &impl crate::{{ record_entity }}Storage,
        user: i64,
        kind: &str,
        text: &str,
    ) -> Result<crate::{{ record_entity }}, String> {
        let delivery = self.send(kind, text).await;
        let _ = user;
        let row: crate::{{ record_entity }} = serde_json::from_value(serde_json::json!({
            "id": 0,
{%- if record_owner_key %}
            {{ record_owner_key }}: user,
{%- endif %}
            "kind": kind,
            "at": chrono::Utc::now(),
            "channel": delivery.channel,
            "text": text,
            "status": delivery.status,
            "error": delivery.error,
            {{ external_id_key }}: delivery.external_id,
        }))
        .map_err(|e| format!("notification row: {}", e))?;
        storage.save_one(row).await.map_err(|e| format!("{:?}", e))
    }
{%- endif %}
}
