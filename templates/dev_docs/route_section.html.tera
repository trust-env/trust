<section class="route">
<h2><span class="method {{ method_class }}">{{ method }}</span> <code>{{ path }}</code></h2>
<p class="use-case">use_case: <code>{{ use_case }}</code></p>
{% if path_params %}<p class="path-params">path params: {% for p in path_params %}<code>{{ p }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>
{% endif -%}
<h3>Request body</h3>
{{ input_table }}
<h3>Response</h3>
<p>Returns <code>{% if output_is_list %}Vec&lt;{{ output_entity }}&gt;{% else %}{{ output_entity }}{% endif %}</code></p>
{{ output_table }}
<h3>Errors</h3>
{{ errors_table }}
</section>
