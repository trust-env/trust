-- Generated by trust from entity `{{ entity }}` — foreign keys, applied once every table exists.
{%- for key in keys %}
DO $$ BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = '{{ key.name }}') THEN
        ALTER TABLE {{ table }} ADD CONSTRAINT {{ key.name }} FOREIGN KEY ({{ key.column }}) REFERENCES {{ key.ref_table }} (id) ON DELETE {{ key.on_delete }};
    END IF;
END $$;
{%- endfor %}
