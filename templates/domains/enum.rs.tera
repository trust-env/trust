#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default, serde::Serialize, serde::Deserialize)]
pub enum {{ name }} {
{%- for v in variants %}
{%- if loop.first %}
    #[default]{% endif %}
    #[serde(rename = "{{ v.wire }}")]
    {{ v.ident }},
{%- endfor %}
}

impl {{ name }} {
    /// Every value, in declaration order.
    pub const ALL: [{{ name }}; {{ variants | length }}] = [{% for v in variants %}{{ name }}::{{ v.ident }}{% if not loop.last %}, {% endif %}{% endfor %}];

    /// The value as written on the wire and in the database.
    pub fn as_str(&self) -> &'static str {
        match self {
{%- for v in variants %}
            {{ name }}::{{ v.ident }} => "{{ v.wire }}",
{%- endfor %}
        }
    }
}

impl std::fmt::Display for {{ name }} {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.write_str(self.as_str())
    }
}

impl std::str::FromStr for {{ name }} {
    type Err = String;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
{%- for v in variants %}
            "{{ v.wire }}" => Ok({{ name }}::{{ v.ident }}),
{%- endfor %}
            other => Err(format!("'{}' is not a valid {{ name }} (expected one of: {% for v in variants %}{{ v.wire }}{% if not loop.last %}, {% endif %}{% endfor %})", other)),
        }
    }
}
