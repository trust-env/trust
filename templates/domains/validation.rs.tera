//! `Regex<...>` field validators: each pattern is compiled once, and a
//! value that doesn't match is rejected while decoding the request
//! (the client gets a 422 with the reason).
{%- if double_option %}

/// `Option<Option<T>>` fields (a patch of a nullable column): a missing
/// field stays `None` (thanks to `#[serde(default)]`), `null` becomes
/// `Some(None)` (clear the column), a value becomes `Some(Some(v))`.
pub fn trust_double_option<'de, T, D>(deserializer: D) -> Result<Option<Option<T>>, D::Error>
where
    T: serde::Deserialize<'de>,
    D: serde::Deserializer<'de>,
{
    <Option<T> as serde::Deserialize>::deserialize(deserializer).map(Some)
}
{%- endif %}
{% for r in regexes %}{% if r.kind == "regex" %}
static {{ r.fn_name | upper }}: std::sync::LazyLock<regex::Regex> =
    std::sync::LazyLock::new(|| regex::Regex::new({{ r.pattern_literal }}).expect("pattern checked by trust"));

pub fn {{ r.fn_name }}<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<String, D::Error> {
    let value = <String as serde::Deserialize>::deserialize(deserializer)?;
    if {{ r.fn_name | upper }}.is_match(&value) {
        Ok(value)
    } else {
        Err(serde::de::Error::custom(format!("'{}' does not match {}", value, {{ r.fn_name | upper }}.as_str())))
    }
}

pub fn {{ r.fn_name }}_opt<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<Option<String>, D::Error> {
    match <Option<String> as serde::Deserialize>::deserialize(deserializer)? {
        Some(value) if {{ r.fn_name | upper }}.is_match(&value) => Ok(Some(value)),
        Some(value) => Err(serde::de::Error::custom(format!("'{}' does not match {}", value, {{ r.fn_name | upper }}.as_str()))),
        None => Ok(None),
    }
}
{% else %}
/// `{{ r.rust_type }}` within{% if r.min %} {{ r.min }} ≤{% endif %} value{% if r.max %} ≤ {{ r.max }}{% endif %}.
fn {{ r.fn_name }}_check(value: {{ r.rust_type }}) -> Result<{{ r.rust_type }}, String> {
{%- if r.min %}
    if value < {{ r.min }} {
        return Err(format!("{} is below the minimum {}", value, {{ r.min }}));
    }
{%- endif %}
{%- if r.max %}
    if value > {{ r.max }} {
        return Err(format!("{} is above the maximum {}", value, {{ r.max }}));
    }
{%- endif %}
    Ok(value)
}

pub fn {{ r.fn_name }}<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<{{ r.rust_type }}, D::Error> {
    let value = <{{ r.rust_type }} as serde::Deserialize>::deserialize(deserializer)?;
    {{ r.fn_name }}_check(value).map_err(serde::de::Error::custom)
}

pub fn {{ r.fn_name }}_opt<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<Option<{{ r.rust_type }}>, D::Error> {
    match <Option<{{ r.rust_type }}> as serde::Deserialize>::deserialize(deserializer)? {
        Some(value) => {{ r.fn_name }}_check(value).map(Some).map_err(serde::de::Error::custom),
        None => Ok(None),
    }
}
{% endif %}{% endfor %}
