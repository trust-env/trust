import SQLConnector from "./mod/common/common.tr"

type Doc {
    id: Int,
    text: String
}

type SummarizeRequest {
    text: String
}

type SummarizeResponse {
    summary: String
}

infra DocInfra {
    storage {
        psql {
            entity: Doc
        }
    }
}

use_case SummarizeUseCase {
    input: SummarizeRequest
    output: SummarizeResponse
    ai {
        infra: DocInfra
        prompt: "summarize the input text"
    }
}

adapter HttpAdapter {
    http {
        on: "0.0.0.0:8080"
        routes {
            POST "/summarize" {
                input: SummarizeRequest
                output: SummarizeResponse
                use_case: SummarizeUseCase
            }
        }
    }
}

note {
    message: "generated by the ai-and-plugin-extensibility scenario"
}

app Main: run {
    HttpAdapter
}
